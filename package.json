{
  "name": "cometa-bot",
  "version": "3.0.0",
  "description": "Cometa Bot - WhatsApp Multi-Device bot escrito en Go",
  "author": "Luis González",
  "license": "MIT",
  "main": "cmd/bot/main.go",
  "scripts": {
    "postinstall": "go mod download && go build -o cometa-bot ./cmd/bot",
    "prestart": "test -f ./cometa-bot || npm run build",
    "setup": "go mod download && go build -o cometa-bot ./cmd/bot",
    "deps": "go mod download",
    "tidy": "go mod tidy",
    "build": "go build -o cometa-bot ./cmd/bot",
    "build:linux": "CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags=\"-s -w\" -o cometa-bot-linux ./cmd/bot",
    "build:windows": "CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -ldflags=\"-s -w\" -o cometa-bot.exe ./cmd/bot",
    "build:darwin": "CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -ldflags=\"-s -w\" -o cometa-bot-mac ./cmd/bot",
    "start": "./cometa-bot",
    "start:linux": "./cometa-bot-linux",
    "start:dev": "go run ./cmd/bot"
  },
  "engines": {
    "go": ">=1.26.4",
    "node": ">=16"
  },
  "dependencies": {},
  "goModule": "go 1.26.4",
  "goDependencies": {
    "direct": {
      "go.mau.fi/whatsmeow": "v0.0.0-20261107160454-79dc2a8c33df",
      "google.golang.org/protobuf": "v1.36.12",
      "modernc.org/sqlite": "v1.62.0"
    },
    "indirect": {
      "filippo.io/edwards25519": "v1.2.0",
      "github.com/beeper/argo-go": "v1.1.2",
      "github.com/coder/websocket": "v1.8.15",
      "github.com/dustin/go-humanize": "v1.1.0",
      "github.com/elliotchance/orderedmap/v3": "v3.1.0",
      "github.com/google/uuid": "v1.6.0",
      "github.com/mattn/go-colorable": "v0.1.14",
      "github.com/mattn/go-isatty": "v0.0.24",
      "github.com/ncruces/go-strftime": "v1.1.0",
      "github.com/petermattis/goid": "v0.0.0-20260918085751-abfca077860b",
      "github.com/remyoudompheng/bigfft": "v0.0.0-20230129092748-24d4a6f8daec",
      "github.com/rs/zerolog": "v1.35.1",
      "github.com/vektah/gqlparser/v2": "v2.5.27",
      "go.mau.fi/libsignal": "v0.2.2",
      "go.mau.fi/util": "v0.11.0",
      "golang.org/x/crypto": "v0.58.0",
      "golang.org/x/exp": "v0.0.0-20261014143641-f0251eb4aa3e",
      "golang.org/x/net": "v0.61.0",
      "golang.org/x/sync": "v0.24.0",
      "golang.org/x/sys": "v0.49.0",
      "golang.org/x/text": "v0.43.0",
      "modernc.org/libc": "v1.80.1",
      "modernc.org/mathutil": "v1.7.1",
      "modernc.org/memory": "v1.12.1"
    }
  },
  "keywords": [
    "whatsapp",
    "bot",
    "go",
    "golang",
    "whatsmeow",
    "multi-device",
    "sqlite",
    "gacha",
    "economy",
    "cometa"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/cometa-bot"
  }
}
